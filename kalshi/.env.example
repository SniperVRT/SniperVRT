# Kalshi API credentials (RSA key auth)
KALSHI_API_KEY_ID=
KALSHI_PRIVATE_KEY_PATH=./secrets/kalshi_private_key.pem
KALSHI_API_BASE=https://api.elections.kalshi.com/trade-api/v2

# Execution mode: signal | paper | live
EXECUTION_MODE=signal

# Bankroll + risk caps (USD)
BANKROLL_USD=100
MAX_POSITION_USD=5
MAX_OPEN_POSITIONS=3
DAILY_LOSS_STOP_USD=10
WEEKLY_LOSS_STOP_USD=30
COOLDOWN_MINUTES_AFTER_LOSS=30

# Signal quality gates
MIN_EDGE=0.05
MIN_CONFIDENCE=0.6
MAX_SPREAD_CENTS=4
MIN_VOLUME_24H=500
MIN_MINUTES_TO_CLOSE=15
MAX_MINUTES_TO_CLOSE=43200

# Storage
DB_PATH=./data/kalshi.db
LOG_LEVEL=INFO
