{
  "name": "snipervrt",
  "version": "0.1.0",
  "private": true,
  "description": "Claude-centered autonomous service orchestration platform",
  "workspaces": [
    "apps/*",
    "packages/*",
    "packages/connectors/*",
    "packages/agents/*"
  ],
  "scripts": {
    "build": "tsc -b",
    "dev:api": "tsx watch apps/api/src/index.ts",
    "dev:worker": "tsx watch apps/worker/src/index.ts",
    "start:api": "node apps/api/dist/index.js",
    "start:worker": "node apps/worker/dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint 'apps/**/*.ts' 'packages/**/*.ts'",
    "typecheck": "tsc -b --noEmit",
    "example": "tsx examples/run-sample-task.ts",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:reset": "tsx scripts/reset-db.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/express": "^4.17.21",
    "@types/pg": "^8.11.0",
    "eslint": "^9.10.0",
    "tsx": "^4.7.0",
    "typescript": "^5.4.0",
    "vitest": "^1.3.0"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.30.0",
    "@modelcontextprotocol/sdk": "^1.0.0",
    "dotenv": "^16.4.0",
    "express": "^4.19.0",
    "ioredis": "^5.3.0",
    "pg": "^8.11.0",
    "playwright": "^1.44.0",
    "pino": "^9.0.0",
    "undici": "^6.15.0",
    "zod": "^3.23.0"
  }
}
