# ============================================================
# SniperVRT - Environment configuration
# ============================================================

# --- Claude / Anthropic -------------------------------------
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_PLANNER_MODEL=claude-opus-4-7
ANTHROPIC_EXECUTOR_MODEL=claude-sonnet-4-6
ANTHROPIC_VALIDATOR_MODEL=claude-sonnet-4-6
ANTHROPIC_RECOVERY_MODEL=claude-sonnet-4-6
ANTHROPIC_BROWSER_MODEL=claude-haiku-4-5-20251001

# --- Database -----------------------------------------------
DATABASE_URL=postgres://snipervrt:snipervrt@localhost:5432/snipervrt

# --- Redis / Queue -----------------------------------------
REDIS_URL=redis://localhost:6379

# --- API server --------------------------------------------
PORT=8080
NODE_ENV=development

# --- Policy defaults ---------------------------------------
DEFAULT_MODE=normal            # normal | dry-run | simulation | shadow
DEFAULT_APPROVAL_REQUIRED=high # never | high | all

# --- Browser fallback --------------------------------------
PLAYWRIGHT_HEADLESS=true
PLAYWRIGHT_STORAGE_DIR=./.browser-state

# --- Telemetry ---------------------------------------------
LOG_LEVEL=info
TRACE_ENABLED=true

# --- Cost controls -----------------------------------------
DAILY_TOKEN_BUDGET=2000000
PER_TASK_TOKEN_BUDGET=150000

# --- Connector: Gmail (Google OAuth) -----------------------
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=

# --- Connector: Google Calendar ----------------------------
GCAL_CLIENT_ID=
GCAL_CLIENT_SECRET=
GCAL_REFRESH_TOKEN=

# --- Connector: Notion -------------------------------------
NOTION_TOKEN=

# --- Connector: GitHub -------------------------------------
GITHUB_TOKEN=

# --- Connector: Supabase -----------------------------------
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- MCP servers (newline or comma separated URIs) ---------
MCP_SERVERS=
