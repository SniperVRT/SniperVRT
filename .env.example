# ============================================================
# SniperVRT BTC AI Trading Platform — environment configuration
# Copy to .env and fill values. NEVER commit a real .env.
# ============================================================

# --- Server ------------------------------------------------
SNIPER_HOST=0.0.0.0
SNIPER_PORT=8000
SNIPER_LOG_LEVEL=INFO

# --- Database ----------------------------------------------
# Default is a local SQLite file under runtime_state/.
# SNIPER_DB_URL=sqlite:///runtime_state/platform.db

# --- Safety ------------------------------------------------
# Hard kill switch. true = refuse ALL new orders (paper + live).
SNIPER_KILL_SWITCH=false

# --- Exchange (live trading) ------------------------------
# Live trading is gated by FOUR independent locks: configs/live.yaml,
# governance approval, human unlock via /api/live/unlock, and these keys.
# Leaving keys empty makes live trading impossible regardless of other state.
SNIPER_EXCHANGE_API_KEY=
SNIPER_EXCHANGE_API_SECRET=
